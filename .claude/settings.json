{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit)",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/verify.sh --quick"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check --fix --quiet ${file} 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
